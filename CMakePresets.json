{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "RGBD_WARNINGS_AS_ERRORS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RGBD_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "asan",
      "displayName": "ASan and UBSan",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "RGBD_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "gemini305",
      "displayName": "Gemini 305",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/gemini305",
      "cacheVariables": {
        "RGBD_WITH_ORBBEC": "ON",
        "OrbbecSDK_DIR": "${sourceDir}/build/_sdk/install/lib"
      }
    },
    {
      "name": "d435i",
      "displayName": "D435i",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/d435i",
      "cacheVariables": {
        "RGBD_WITH_REALSENSE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "gemini305",
      "configurePreset": "gemini305"
    },
    {
      "name": "d435i",
      "configurePreset": "d435i"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
